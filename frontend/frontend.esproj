<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6887863">
  <!-- Lets Visual Studio show the Next.js app in Solution Explorer. The app is run with npm, not MSBuild. -->
  <PropertyGroup>
    <StartupCommand>npm run dev</StartupCommand>
    <BuildCommand>npm run build</BuildCommand>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\.next</BuildOutputFolder>
  </PropertyGroup>
</Project>
